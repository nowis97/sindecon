{
  "name": "sindecon",
  "main": "./worker.ts",
  "compatibility_date": "2026-04-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DECKS_DB",
      "database_name": "sindecon-decks",
      "database_id": "c542c2b7-1808-473a-9675-cd1b71d9f000"
    }
  ]
}
